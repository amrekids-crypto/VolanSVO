        </dependency>
        <dependency>
            <groupId>devlibs</groupId>
            <artifactId>adventure-api-4.20.0</artifactId>
            <version>1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/devlibs/adventure-api-4.20.0.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>devlibs</groupId>
            <artifactId>adventure-key-4.20.0</artifactId>
            <version>1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/devlibs/adventure-key-4.20.0.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>devlibs</groupId>
