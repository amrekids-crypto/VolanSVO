        <dependency>
            <groupId>devlibs</groupId>
            <artifactId>log4j-api-2.24.1</artifactId>
            <version>1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/devlibs/log4j-api-2.24.1.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>devlibs</groupId>
            <artifactId>netty-buffer-4.1.115.Final</artifactId>
            <version>1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/devlibs/netty-buffer-4.1.115.Final.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>devlibs</groupId>
            <artifactId>netty-codec-4.1.115.Final</artifactId>
            <version>1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/devlibs/netty-codec-4.1.115.Final.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>devlibs</groupId>
            <artifactId>netty-common-4.1.115.Final</artifactId>
            <version>1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/devlibs/netty-common-4.1.115.Final.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>devlibs</groupId>
            <artifactId>netty-handler-4.1.115.Final</artifactId>
