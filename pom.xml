            <scope>system</scope>
            <systemPath>${project.basedir}/devlibs/examination-api-1.3.0.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>devlibs</groupId>
            <artifactId>fastutil-8.5.15</artifactId>
            <version>1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/devlibs/fastutil-8.5.15.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>devlibs</groupId>
