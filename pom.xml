            <groupId>devlibs</groupId>
            <artifactId>adventure-text-serializer-legacy-4.20.0</artifactId>
            <version>1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/devlibs/adventure-text-serializer-legacy-4.20.0.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>devlibs</groupId>
            <artifactId>authlib-6.0.57</artifactId>
            <version>1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/devlibs/authlib-6.0.57.jar</systemPath>
