        </dependency>
        <dependency>
            <groupId>devlibs</groupId>
            <artifactId>guava-33.3.1-jre</artifactId>
            <version>1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/devlibs/guava-33.3.1-jre.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>devlibs</groupId>
            <artifactId>joml-1.10.8</artifactId>
            <version>1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/devlibs/joml-1.10.8.jar</systemPath>
