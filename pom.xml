            <systemPath>${project.basedir}/devlibs/paper-api-1.21.4-R0.1-SNAPSHOT.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>devlibs</groupId>
            <artifactId>paper-server-mojmap-1.21.4</artifactId>
            <version>1</version>
            <scope>system</scope>
